# Preparation profile only: current mainnet pool operations remain release-blocked.
# Set the same chain list for the server and the Vite build. Do not reuse the testnet pool or HYL token CA.
PRIVACY_CHAIN_IDS=4663
VITE_PRIVACY_CHAIN_IDS=4663
PRIVACY_ASP_AUTO_PUBLISH_SECONDS=0
# Native ETH release target. Final artifact pins and release review are still required before activation.
PRIVACY_PROTOCOL=hylsia-pp-v2-eth
VITE_PRIVACY_PROTOCOL=hylsia-pp-v2-eth

# Public fallback RPC is in the registry. A production deployment needs a suitable provider/archive endpoint.
PRIVACY_RPC_URL_4663=
VITE_PRIVACY_RPC_URL_4663=
PRIVACY_DEPLOY_RPC_URL_4663=

# Leave these blank until a new mainnet pool has a verified deployment receipt.
PRIVACY_POOL_ADDRESS_4663=
VITE_PRIVACY_POOL_ADDRESS_4663=
PRIVACY_POOL_DEPLOY_BLOCK_4663=
VITE_PRIVACY_POOL_DEPLOY_BLOCK_4663=

# Owner and publisher may share a wallet. Deployer may equal either; relayer is optional.
PRIVACY_DEPLOYER_ADDRESS=
PRIVACY_POOL_OWNER=
PRIVACY_ASP_POSTMAN=
PRIVACY_RELAYER_ADDRESS=

# Choose exactly one signer. These fields are aliases/settings, never private keys or passwords.
# Alternatively use env with a privately configured DEPLOY_PRIVATE_KEY_MAINNET at explicit signing.
PRIVACY_DEPLOY_SIGNER=
PRIVACY_DEPLOY_ACCOUNT=
PRIVACY_DEPLOY_HARDWARE=
# Keystore only: path to a password file in your secret store. Never put its contents here.
PRIVACY_DEPLOY_PASSWORD_FILE=
# Optional extra maximum ETH gas cap. Broadcast always checks actual balance against the simulation.
PRIVACY_DEPLOY_GAS_BUDGET_ETH=

# Configure runtime service secrets only after the approved deployment.
# Relayer uses a separate account. A shared owner/publisher key also grants administration;
# separate publisher custody avoids placing owner authority in a long-running service.
PRIVACY_RELAYER_PRIVATE_KEY_4663_FILE=
PRIVACY_ASP_POSTMAN_PRIVATE_KEY_4663_FILE=

# Completing this file does not clear protocol, production-ceremony or review blockers.
