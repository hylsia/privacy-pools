# Preparation only. Use a separately built and reviewed package for Ethereum, chain ID 1.
PRIVACY_CHAIN_IDS=1
VITE_PRIVACY_CHAIN_IDS=1
PRIVACY_PROTOCOL=hylsia-pp-v2-eth
VITE_PRIVACY_PROTOCOL=hylsia-pp-v2-eth
PRIVACY_ASP_AUTO_PUBLISH_SECONDS=0
PRIVACY_RPC_URL_1=
VITE_PRIVACY_RPC_URL_1=
PRIVACY_DEPLOY_RPC_URL_1=
PRIVACY_POOL_ADDRESS_1=
VITE_PRIVACY_POOL_ADDRESS_1=
PRIVACY_POOL_DEPLOY_BLOCK_1=
VITE_PRIVACY_POOL_DEPLOY_BLOCK_1=
# Public roles can be suffixed per chain. Owner, publisher and deployer may share a wallet.
# Relayer is optional for deployment. Unsuffixed values are shared defaults.
PRIVACY_DEPLOYER_ADDRESS_1=
PRIVACY_POOL_OWNER_1=
PRIVACY_ASP_POSTMAN_1=
PRIVACY_RELAYER_ADDRESS_1=
PRIVACY_DEPLOY_GAS_BUDGET_ETH_1=
# Select exactly one signer: env, keystore alias or Ledger.
PRIVACY_DEPLOY_SIGNER=
# PRIVACY_DEPLOY_SIGNER=env uses DEPLOY_PRIVATE_KEY_MAINNET from your private local .env at signing.
PRIVACY_DEPLOY_ACCOUNT=
PRIVACY_DEPLOY_HARDWARE=
PRIVACY_DEPLOY_PASSWORD_FILE=
PRIVACY_RELAYER_PRIVATE_KEY_1_FILE=
PRIVACY_ASP_POSTMAN_PRIVATE_KEY_1_FILE=
