# Enable the exact user-authorized single-operator Ethereum release alongside the testnet server.
PRIVACY_ENABLE_MAINNET_APP=true
VITE_PRIVACY_ENABLE_MAINNET_APP=true
# Mainnet is selected explicitly from the application network menu; defaults can remain testnet.
PRIVACY_CHAIN_IDS=46630
VITE_PRIVACY_CHAIN_IDS=46630
# Optional production/archive Ethereum providers. VITE_ values must contain no secrets.
PRIVACY_RPC_URL_1=
VITE_PRIVACY_RPC_URL_1=
# Publisher signs manually in its wallet. Self-paid withdrawals need no server relayer key.
# Never copy the deployment/owner key into the hosted runtime.
