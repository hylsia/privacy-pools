# Local v2 development only. Start Anvil separately; fill the actual pool address after DeployV2Dev.s.sol succeeds.
PRIVACY_PROTOCOL=hylsia-pp-v2-candidate
VITE_PRIVACY_PROTOCOL=hylsia-pp-v2-candidate
PRIVACY_CHAIN_IDS=31337
VITE_PRIVACY_CHAIN_IDS=31337
PRIVACY_RPC_URL_31337=http://127.0.0.1:8550
VITE_PRIVACY_RPC_URL_31337=http://127.0.0.1:8550
PRIVACY_POOL_ADDRESS_31337=
VITE_PRIVACY_POOL_ADDRESS_31337=
PRIVACY_ASP_AUTO_PUBLISH_SECONDS=0
PRIVACY_ASP_INCLUSION_DELAY_SECONDS_31337=0
# Dev artifacts are served only by NODE_ENV=development over a loopback request.
# No private keys belong in this template. npm run zk:v2:e2e derives disposable local service keys in memory.
