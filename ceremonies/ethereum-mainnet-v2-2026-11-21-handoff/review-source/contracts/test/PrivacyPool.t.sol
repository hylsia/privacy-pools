pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {PrivacyPool} from "../src/PrivacyPool.sol";
import {WithdrawVerifier} from "../src/verifiers/WithdrawVerifier.sol";
import {CommitmentVerifier} from "../src/verifiers/CommitmentVerifier.sol";
import {ICommitmentVerifier, IWithdrawVerifier} from "../src/interfaces/IVerifiers.sol";

/**
 * Tests run against REAL Groth16 proofs generated by scripts/privacy/gen-fixtures.ts.
 * The pool is deployed from DEPLOYER (nonce 0) so its address, SCOPE and labels
 * match the fixture exactly. If this test complains about a pool/scope mismatch,
 * regenerate the fixture: `npm run zk:fixtures`.
 */
abstract contract PoolFixtureTest is Test {
    address constant DEPLOYER = 0x1111111111111111111111111111111111111111;
    address constant OWNER = address(0xA11CE);
    address constant POSTMAN = address(0xB0B);

    PrivacyPool pool;
    WithdrawVerifier withdrawVerifier;
    CommitmentVerifier commitmentVerifier;
    string json;

    struct WithdrawFixture {
        PrivacyPool.Withdrawal w;
        PrivacyPool.Groth16Proof proof;
        uint256[6] pubSignals;
    }

    function setUp() public virtual {
        vm.chainId(31337);
        withdrawVerifier = new WithdrawVerifier();
        commitmentVerifier = new CommitmentVerifier();
        vm.prank(DEPLOYER);
        pool = new PrivacyPool(
            OWNER, POSTMAN, IWithdrawVerifier(address(withdrawVerifier)), ICommitmentVerifier(address(commitmentVerifier)), 0
        );
        json = vm.readFile("test/fixtures/pool.json");
        assertEq(address(pool), vm.parseJsonAddress(json, ".pool"), "pool address differs from fixture; run npm run zk:fixtures");
        assertEq(pool.SCOPE(), vm.parseJsonUint(json, ".scope"), "scope differs from fixture");
    }

    // ───────────────────────── helpers ─────────────────────────

    function depositorOf(uint256 i) internal pure returns (address) {
        return address(uint160(0xD000 + i));
    }

    function _deposit(uint256 i) internal returns (uint256 commitment) {
        string memory k = string.concat(".deposits[", vm.toString(i), "]");
        uint256 value = vm.parseJsonUint(json, string.concat(k, ".value"));
        uint256 pre = vm.parseJsonUint(json, string.concat(k, ".precommitment"));
        address depositor = depositorOf(i);
        vm.deal(depositor, value);
        vm.prank(depositor);
        commitment = pool.deposit{value: value}(pre);
        assertEq(commitment, vm.parseJsonUint(json, string.concat(k, ".commitment")), "commitment mismatch");
    }

    function _depositAll() internal {
        for (uint256 i = 0; i < 3; i++) _deposit(i);
        assertEq(pool.getLastRoot(), vm.parseJsonUint(json, ".stateRootAfterDeposits"), "state root mismatch after deposits");
    }

    function _publishASP() internal {
        vm.prank(POSTMAN);
        pool.updateASPRoot(vm.parseJsonUint(json, ".aspRoot"), "fixture");
    }

    function _proof(string memory key) internal view returns (PrivacyPool.Groth16Proof memory p) {
        uint256[] memory a = vm.parseJsonUintArray(json, string.concat(key, ".pA"));
        uint256[] memory b = vm.parseJsonUintArray(json, string.concat(key, ".pB"));
        uint256[] memory c = vm.parseJsonUintArray(json, string.concat(key, ".pC"));
        p.pA = [a[0], a[1]];
        p.pB = [[b[0], b[1]], [b[2], b[3]]];
        p.pC = [c[0], c[1]];
    }

    function _withdrawFixture(string memory key) internal view returns (WithdrawFixture memory f) {
        f.w = PrivacyPool.Withdrawal({
            recipient: vm.parseJsonAddress(json, string.concat(key, ".withdrawal.recipient")),
            relayer: vm.parseJsonAddress(json, string.concat(key, ".withdrawal.relayer")),
            fee: vm.parseJsonUint(json, string.concat(key, ".withdrawal.fee")),
            deadline: vm.parseJsonUint(json, string.concat(key, ".withdrawal.deadline"))
        });
        f.proof = _proof(key);
        uint256[] memory ps = vm.parseJsonUintArray(json, string.concat(key, ".pubSignals"));
        for (uint256 i = 0; i < 6; i++) f.pubSignals[i] = ps[i];
    }

    function _ragequitFixture(string memory key)
        internal
        view
        returns (PrivacyPool.Groth16Proof memory p, uint256[4] memory ps)
    {
        p = _proof(key);
        uint256[] memory arr = vm.parseJsonUintArray(json, string.concat(key, ".pubSignals"));
        for (uint256 i = 0; i < 4; i++) ps[i] = arr[i];
    }

    function _ready() internal {
        _depositAll();
        _publishASP();
    }

}

contract PrivacyPoolTest is PoolFixtureTest {
    // ───────────────────────── deposits ─────────────────────────

    function test_depositRecordsCommitmentLabelAndDepositor() public {
        uint256 c = _deposit(0);
        assertTrue(pool.commitments(c));
        uint256 label = vm.parseJsonUint(json, ".deposits[0].label");
        assertEq(pool.depositors(label), depositorOf(0));
        assertEq(pool.nextIndex(), 1);
        assertEq(address(pool).balance, 1 ether);
    }

    function test_depositRejectsZeroValueAndBadField() public {
        vm.expectRevert(PrivacyPool.InvalidDepositValue.selector);
        pool.deposit{value: 0}(1);
        vm.deal(address(this), 1 ether);
        vm.expectRevert(PrivacyPool.InvalidFieldElement.selector);
        pool.deposit{value: 1 ether}(type(uint256).max);
    }

    function test_depositRespectsMinDeposit() public {
        vm.prank(OWNER);
        pool.setMinDeposit(1 ether);
        vm.deal(address(this), 1 ether);
        vm.expectRevert(PrivacyPool.InvalidDepositValue.selector);
        pool.deposit{value: 0.5 ether}(1);
    }

    // ───────────────────────── withdrawals ─────────────────────────

    function test_withdrawPartialThenSpendChange() public {
        _ready();
        WithdrawFixture memory f1 = _withdrawFixture(".withdraw1");
        uint256 amount1 = vm.parseJsonUint(json, ".withdraw1.amount");

        address anyone = address(0xCAFE);
        vm.prank(anyone); // anyone may submit; funds go where the proof says
        pool.withdraw(f1.w, f1.proof, f1.pubSignals);

        assertEq(f1.w.recipient.balance, amount1 - f1.w.fee, "recipient net amount");
        assertEq(f1.w.relayer.balance, f1.w.fee, "relayer fee");
        assertTrue(pool.nullifierHashes(f1.pubSignals[1]), "nullifier spent");
        assertTrue(pool.commitments(f1.pubSignals[0]), "change commitment inserted");
        assertEq(pool.nextIndex(), 4);
        assertEq(pool.getLastRoot(), vm.parseJsonUint(json, ".stateRootAfterWithdraw1"), "root after change insert");

        // spend the change note in full, self-relayed (fee 0, relayer 0)
        WithdrawFixture memory f2 = _withdrawFixture(".withdraw2");
        uint256 amount2 = vm.parseJsonUint(json, ".withdraw2.amount");
        pool.withdraw(f2.w, f2.proof, f2.pubSignals);
        assertEq(f2.w.recipient.balance, amount2, "change fully withdrawn");
        assertEq(address(pool).balance, 3.5 ether - amount1 - amount2 + 0, "pool balance conserved");
        // (3.5 ETH deposited; 1 ETH from deposit 0 fully paid out across both withdrawals)
        assertEq(address(pool).balance, 2.5 ether);
    }

    function test_withdrawRejectsReplay() public {
        _ready();
        WithdrawFixture memory f = _withdrawFixture(".withdraw1");
        pool.withdraw(f.w, f.proof, f.pubSignals);
        vm.expectRevert(PrivacyPool.NullifierAlreadySpent.selector);
        pool.withdraw(f.w, f.proof, f.pubSignals);
    }

    function test_withdrawRejectsTamperedRecipient() public {
        _ready();
        WithdrawFixture memory f = _withdrawFixture(".withdraw1");
        f.w.recipient = address(0xBAD);
        vm.expectRevert(PrivacyPool.ContextMismatch.selector);
        pool.withdraw(f.w, f.proof, f.pubSignals);
    }

    function test_withdrawRejectsTamperedFeeAndRelayer() public {
        _ready();
        WithdrawFixture memory f = _withdrawFixture(".withdraw1");
        f.w.fee = f.w.fee + 1;
        vm.expectRevert(PrivacyPool.ContextMismatch.selector);
        pool.withdraw(f.w, f.proof, f.pubSignals);

        f = _withdrawFixture(".withdraw1");
        f.w.relayer = address(0xBAD);
        vm.expectRevert(PrivacyPool.ContextMismatch.selector);
        pool.withdraw(f.w, f.proof, f.pubSignals);
    }

    function test_withdrawRejectsTamperedAmount() public {
        _ready();
        WithdrawFixture memory f = _withdrawFixture(".withdraw1");
        f.pubSignals[2] = f.pubSignals[2] + 1; // claim more than proven
        vm.expectRevert(PrivacyPool.InvalidProof.selector);
        pool.withdraw(f.w, f.proof, f.pubSignals);
    }

    function test_withdrawRejectsInvalidProof() public {
        _ready();
        WithdrawFixture memory f = _withdrawFixture(".withdraw1");
        f.proof.pA[0] = f.proof.pA[0] ^ 1;
        vm.expectRevert(PrivacyPool.InvalidProof.selector);
        pool.withdraw(f.w, f.proof, f.pubSignals);
    }

    function test_withdrawRejectsUnknownStateRoot() public {
        _deposit(0); // only one deposit → different root than the fixture proof
        _publishASP();
        WithdrawFixture memory f = _withdrawFixture(".withdraw1");
        vm.expectRevert(PrivacyPool.UnknownStateRoot.selector);
        pool.withdraw(f.w, f.proof, f.pubSignals);
    }

    function test_withdrawRejectsUnknownASPRoot() public {
        _depositAll(); // no ASP root published
        WithdrawFixture memory f = _withdrawFixture(".withdraw1");
        vm.expectRevert(PrivacyPool.UnknownASPRoot.selector);
        pool.withdraw(f.w, f.proof, f.pubSignals);
    }

    function test_withdrawAcceptsHistoricalASPRoot() public {
        _ready();
        vm.prank(POSTMAN);
        pool.updateASPRoot(12345, "newer"); // ASP moved on; old root still in history
        WithdrawFixture memory f = _withdrawFixture(".withdraw1");
        pool.withdraw(f.w, f.proof, f.pubSignals);
        assertTrue(pool.nullifierHashes(f.pubSignals[1]));
    }

    function test_withdrawRespectsDeadline() public {
        _ready();
        // withdraw3 was proven against the 4-leaf root, so apply withdraw1 first
        WithdrawFixture memory f1 = _withdrawFixture(".withdraw1");
        pool.withdraw(f1.w, f1.proof, f1.pubSignals);

        WithdrawFixture memory f3 = _withdrawFixture(".withdraw3");
        vm.warp(f3.w.deadline + 1);
        vm.expectRevert(PrivacyPool.Expired.selector);
        pool.withdraw(f3.w, f3.proof, f3.pubSignals);

        vm.warp(f3.w.deadline);
        pool.withdraw(f3.w, f3.proof, f3.pubSignals);
        assertEq(f3.w.recipient.balance, (vm.parseJsonUint(json, ".withdraw1.amount") - f1.w.fee) + 1 ether);
    }

    function test_withdrawWorksAfterWindDown() public {
        _ready();
        vm.prank(OWNER);
        pool.windDown();
        WithdrawFixture memory f = _withdrawFixture(".withdraw1");
        pool.withdraw(f.w, f.proof, f.pubSignals);
        assertTrue(pool.nullifierHashes(f.pubSignals[1]));
    }

    // ───────────────────────── ragequit ─────────────────────────

    function test_ragequitOnlyDepositor() public {
        _depositAll();
        (PrivacyPool.Groth16Proof memory p, uint256[4] memory ps) = _ragequitFixture(".ragequit1");
        vm.prank(depositorOf(0));
        vm.expectRevert(PrivacyPool.NotDepositor.selector);
        pool.ragequit(p, ps);
    }

    function test_ragequitReturnsFundsWithoutASP() public {
        _depositAll(); // deliberately no ASP root
        (PrivacyPool.Groth16Proof memory p, uint256[4] memory ps) = _ragequitFixture(".ragequit1");
        address depositor = depositorOf(1);
        uint256 before = depositor.balance;
        vm.prank(depositor);
        pool.ragequit(p, ps);
        assertEq(depositor.balance - before, 0.5 ether);
        assertTrue(pool.nullifierHashes(ps[1]));

        vm.prank(depositor);
        vm.expectRevert(PrivacyPool.NullifierAlreadySpent.selector);
        pool.ragequit(p, ps);
    }

    function test_ragequitRejectsSpentNote() public {
        _ready();
        WithdrawFixture memory f = _withdrawFixture(".withdraw1");
        pool.withdraw(f.w, f.proof, f.pubSignals);
        (PrivacyPool.Groth16Proof memory p, uint256[4] memory ps) = _ragequitFixture(".ragequit0");
        vm.prank(depositorOf(0));
        vm.expectRevert(PrivacyPool.NullifierAlreadySpent.selector);
        pool.ragequit(p, ps);
    }

    function test_ragequitRejectsInvalidProof() public {
        _depositAll();
        (PrivacyPool.Groth16Proof memory p, uint256[4] memory ps) = _ragequitFixture(".ragequit1");
        ps[2] = ps[2] + 1; // claim a bigger value
        vm.prank(depositorOf(1));
        vm.expectRevert(PrivacyPool.InvalidProof.selector);
        pool.ragequit(p, ps);
    }

    // ───────────────────────── admin ─────────────────────────

    function test_windDownBlocksDepositsOnly() public {
        vm.prank(OWNER);
        pool.windDown();
        assertTrue(pool.dead());
        vm.deal(address(this), 1 ether);
        vm.expectRevert(PrivacyPool.PoolIsDead.selector);
        pool.deposit{value: 1 ether}(1);
    }

    function test_adminFunctionsAreGated() public {
        vm.expectRevert(PrivacyPool.Unauthorized.selector);
        pool.windDown();
        vm.expectRevert(PrivacyPool.Unauthorized.selector);
        pool.updateASPRoot(1, "");
        vm.expectRevert(PrivacyPool.Unauthorized.selector);
        pool.setASPPostman(address(1));
        vm.prank(OWNER);
        pool.setASPPostman(address(0xC0FFEE));
        assertEq(pool.aspPostman(), address(0xC0FFEE));
        vm.prank(POSTMAN);
        vm.expectRevert(PrivacyPool.Unauthorized.selector);
        pool.updateASPRoot(1, "");
    }

    function test_aspRootHistoryBounded() public {
        for (uint256 i = 1; i <= 17; i++) {
            vm.prank(POSTMAN);
            pool.updateASPRoot(i, "");
        }
        assertFalse(pool.isKnownASPRoot(1), "oldest root evicted");
        assertTrue(pool.isKnownASPRoot(2));
        assertTrue(pool.isKnownASPRoot(17));
        assertEq(pool.currentASPRoot(), 17);
    }

    function test_poolDoesNotAcceptPlainEther() public {
        vm.deal(address(this), 1 ether);
        (bool ok,) = address(pool).call{value: 1 ether}("");
        assertFalse(ok);
    }
}
