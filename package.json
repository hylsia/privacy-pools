{
  "name": "hylsia",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && npm run build:serverless",
    "build:serverless": "esbuild server/_core/serverless.ts --platform=node --packages=external --bundle --format=esm --target=node20 --outfile=dist/serverless/index.mjs",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "check:privacy-scripts": "tsc --project tsconfig.privacy-scripts.json",
    "check:artifacts": "node --import tsx scripts/privacy/check-frozen-artifacts.ts --tracked-only",
    "format": "prettier --write .",
    "test": "vitest run",
    "zk:build": "tsx scripts/privacy/build-circuits.ts",
    "zk:fixtures": "tsx scripts/privacy/gen-fixtures.ts",
    "zk:contracts:build": "forge build --root contracts",
    "zk:contracts:test": "forge test --root contracts -vv",
    "zk:deploy:local": "forge script --root contracts contracts/script/Deploy.s.sol:Deploy --rpc-url http://127.0.0.1:8545 --broadcast && tsx scripts/privacy/sync-deployments.ts --include-local",
    "zk:deploy:robinhood": "tsx scripts/privacy/deploy.ts --network robinhood-testnet",
    "zk:deploy:robinhood-mainnet": "node --import tsx scripts/privacy/deploy.ts --network robinhood-mainnet",
    "zk:mainnet:preflight": "node --import tsx scripts/privacy/mainnet-preflight.ts",
    "zk:mainnet:wallet": "node --import tsx scripts/privacy/mainnet-wallet.ts",
    "zk:v2:build:dev": "node --import tsx scripts/privacy/v2/build-dev.ts",
    "zk:v2:fixtures": "node --import tsx scripts/privacy/v2/gen-fixtures.ts",
    "zk:v2:e2e": "node --import tsx scripts/privacy/v2/e2e.ts",
    "zk:v2:ceremony:prepare": "node --import tsx scripts/privacy/v2/prepare-mainnet-ceremony.ts",
    "zk:v2:ceremony:verify:phase1": "node node_modules/snarkjs/build/cli.cjs powersoftau verify",
    "zk:v2:release:build": "node --import tsx scripts/privacy/v2/build-release.ts",
    "zk:v2:deploy:native-eth": "node --import tsx scripts/privacy/v2/deploy-native-eth.ts",
    "zk:v2:deploy:smoke": "node --import tsx scripts/privacy/v2/deployment-smoke.ts",
    "zk:deploy:testnet": "npm run zk:deploy:robinhood --",
    "zk:deployments:sync": "tsx scripts/privacy/sync-deployments.ts --check-onchain",
    "zk:e2e": "tsx scripts/privacy/e2e.ts",
    "zk:asp:publish": "tsx scripts/privacy/asp-publish.ts",
    "zk:snapshot": "tsx scripts/privacy/snapshot.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.1.5",
    "next-themes": "^0.4.6",
    "poseidon-lite": "^0.3.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^2.15.2",
    "snarkjs": "^0.7.6",
    "sonner": "^2.0.7",
    "superjson": "^1.13.3",
    "tailwind-merge": "^3.3.1",
    "viem": "^2.46.3",
    "wagmi": "^2.19.5",
    "wouter": "^3.3.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@builder.io/vite-plugin-jsx-loc": "^0.1.1",
    "@tailwindcss/vite": "^4.1.3",
    "@types/body-parser": "^1.19.6",
    "@types/express": "4.17.21",
    "@types/express-serve-static-core": "^4.19.6",
    "@types/node": "^24.7.0",
    "@types/qs": "^6.14.0",
    "@types/range-parser": "^1.2.7",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/send": "^1.2.1",
    "@types/serve-static": "^2.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "circom2": "^0.2.23",
    "circomlib": "^2.0.5",
    "esbuild": "^0.25.0",
    "poseidon-solidity": "^0.0.5",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-manus-runtime": "^0.0.57",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
